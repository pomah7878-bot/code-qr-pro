# CODE QR PRO вАФ production environment
# Copy to server/.env and chmod 600. Never commit the real file.

NODE_ENV=production
HOST=127.0.0.1
PORT=3100
PUBLIC_URL=https://code-qr.stockcity.ru

DB_PATH=/opt/code-qr/server/data/app.db
JOBS_DIR=/opt/code-qr/server/data/jobs
ARTIFACTS_DIR=/opt/code-qr/server/data/artifacts
ADS_DIR=/opt/code-qr/server/data/ads
BACKUP_DIR=/opt/backups/code-qr

# 32-byte base64 key. If omitted, server/data/.app-key is generated.
# Keep the key separately from backups; without it encrypted backups cannot be restored.
APP_ENCRYPTION_KEY=
APP_KEY_FILE=/opt/code-qr/server/data/.app-key

# Fallback for password-reset code hashes. Set a long random value.
PASSWORD_RESET_SECRET=
APP_SECRET=
TFA_TICKET_SECRET=

ADMIN_SESSION_DAYS=7
ADMIN_IDLE_MINUTES=120

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# SMTP fallback (can also be configured in admin settings)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=CODE QR PRO

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# Optional S3-compatible artifact storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH=0
S3_PREFIX=artifacts

# DSH (AI-помощник админки на локальном агенте).  люч модели Ч только на сервере.
# DEEPSEEK_API_KEY=
# DSH_HOME=/opt/code-qr/server/data/dsh-home
# DSH_PROFILE=ai-support

