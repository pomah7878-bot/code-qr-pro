КонецФункции

&НаКлиенте
Процедура ОтправитьВCodeQRPro(Команда)
    ОтправитьВCodeQRProНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОтправитьВCodeQRProНаСервере()
    Строки = СобратьКодыИзДокумента(Объект.Ссылка);
    Если Строки.Количество() = 0 Тогда
        Сообщить("Нет кодов для отправки");
        Возврат;
    КонецЕсли;
    Клиент = CodeQRProClient;
    Клиент.Инициализировать("https://code-qr.stockcity.ru", ПолучитьAPIКлюч());
    Задание = Клиент.СоздатьЗадание(
        "1С-" + Строка(Объект.Номер),
        "cz",
        "png",
        Строки,
        Строка(Объект.Ссылка.УникальныйИдентификатор())
    );
    Сообщить("Создано задание CODE QR PRO №" + Задание.id);
    // Дальше можно опрашивать статус и сохранять результат.
КонецПроцедуры

&НаСервере
Функция ПолучитьAPIКлюч()
