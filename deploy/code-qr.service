[Unit]
Description=CODE QR PRO — GS1 DataMatrix SaaS
After=network.target

[Service]
Type=simple
User=codeqr
Group=codeqr
WorkingDirectory=/opt/code-qr/server
Environment=NODE_ENV=production
EnvironmentFile=-/opt/code-qr/server/.env
Environment=HOST=127.0.0.1
Environment=PORT=3100
ExecStart=/usr/bin/node /opt/code-qr/server/src/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/code-qr/server/data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
