// Общий модуль CodeQRProClient для 1С:УТ 11.5 / ERP 2.5 / УНФ 3 / Розница 3.
// Серверный, вызов сервера. Вставить в расширение конфигурации.
// Требуется платформа 8.3.24+ и HTTPS.

Перем БазовыйURL;
Перем APIКлюч;
Перем Таймаут;

Функция Инициализировать(Знач Адрес, Знач Ключ, Знач ТаймаутСекунд = 30) Экспорт
    БазовыйURL = СокрЛП(Адрес);
    APIКлюч = СокрЛП(Ключ);
    Таймаут = ТаймаутСекунд;
    Если ПустаяСтрока(БазовыйURL) Или ПустаяСтрока(APIКлюч) Тогда
        ВызватьИсключение "CODE QR PRO: не заданы адрес или API-ключ";
    КонецЕсли;
    Возврат Истина;
КонецФункции

Функция Заголовки() Экспорт
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("X-API-Key", APIКлюч);
    Заголовки.Вставить("Accept", "application/json");
    Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Возврат Заголовки;
КонецФункции

Функция РазобратьURL(Знач Адрес)
    Результат = Новый Структура("Хост, Порт, Путь", "", 443, "/");
    Адрес = СокрЛП(Адрес);
    Позиция = СтрНайти(Адрес, "://");
    Если Позиция > 0 Тогда
        Адрес = Сред(Адрес, Позиция + 3);
    КонецЕсли;
    Слэш = СтрНайти(Адрес, "/");
    Если Слэш > 0 Тогда
        Результат.Путь = Сред(Адрес, Слэш);
        Адрес = Лев(Адрес, Слэш - 1);
    КонецЕсли;
    Двоеточие = СтрНайти(Адрес, ":");
    Если Двоеточие > 0 Тогда
        Результат.Хост = Лев(Адрес, Двоеточие - 1);
        Результат.Порт = Число(Сред(Адрес, Двоеточие + 1));
    Иначе
        Результат.Хост = Адрес;
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция Выполнить(Знач Метод, Знач Путь, Знач ТелоЗапроса = Неопределено) Экспорт
    УРЛ = РазобратьURL(БазовыйURL);
    Соединение = Новый HTTPСоединение(
        УРЛ.Хост, УРЛ.Порт, , , , Таймаут,
        Новый ЗащищенноеСоединениеOpenSSL()
    );
    Адрес = УРЛ.Путь;
    Если Прав(Адрес, 1) = "/" И Лев(Путь, 1) = "/" Тогда
        Адрес = Лев(Адрес, Длина(Адрес) - 1);
    КонецЕсли;
    Адрес = Адрес + Путь;
    Запрос = Новый HTTPЗапрос(Адрес, Заголовки());
    Запрос.УстановитьЗаголовок("X-API-Key", APIКлюч);
    Если Метод = "POST" Или Метод = "PATCH" Тогда
        Если ТелоЗапроса = Неопределено Тогда
            ТелоСтрокой = "{}";
        Иначе
            ТелоСтрокой = ЗаписатьJSON(ТелоЗапроса);
        КонецЕсли;
        Запрос.УстановитьТелоИзСтроки(ТелоСтрокой, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
    КонецЕсли;
    Ответ = Новый HTTPОтвет;
    Попытка
        Соединение.Вызвать(Запрос, Ответ);
    Исключение
        ВызватьИсключение "CODE QR PRO: нет связи с сервисом (" + ОписаниеОшибки() + ")";
    КонецПопытки;
    Код = Ответ.ПолучитьКодСостояния();
    Текст = Ответ.ПолучитьТелоКакСтроку();
    Результат = Новый Структура("Код, Текст, Данные", Код, Текст, Неопределено);
    Если Не ПустаяСтрока(Текст) Тогда
        Попытка
            Результат.Данные = ПрочитатьJSON(Текст, Ложь);
        Исключение
            Результат.Данные = Текст;
        КонецПопытки;
    КонецЕсли;
    Если Код >= 400 Тогда
        Сообщение = Текст;
        Если ТипЗнч(Результат.Данные) = Тип("Структура") И Результат.Данные.Свойство("error") Тогда
            Сообщение = Результат.Данные.error;
        КонецЕсли;
        ВызватьИсключение "CODE QR PRO: HTTP " + Код + " — " + Сообщение;
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция СоздатьЗадание(Знач Имя, Знач Режим, Знач Формат, Знач Строки, Знач КлючИдемпотентности = "") Экспорт
    ТелоЗапроса = Новый Структура;
    ТелоЗапроса.Вставить("name", Лев(СокрЛП(Имя), 120));
    ТелоЗапроса.Вставить("mode", Режим);
    ТелоЗапроса.Вставить("format", Формат);
    ТелоЗапроса.Вставить("rows", Строки);
    Если Не ПустаяСтрока(КлючИдемпотентности) Тогда
        ТелоЗапроса.Вставить("idemKey", КлючИдемпотентности);
    КонецЕсли;
    Ответ = Выполнить("POST", "/api/v1/generate", ТелоЗапроса);
    Возврат Ответ.Данные.job;
КонецФункции

Функция ПолучитьЗадание(Знач ИД) Экспорт
    Ответ = Выполнить("GET", "/api/v1/jobs/" + Формат(ИД, "ЧГ=0"));
    Возврат Ответ.Данные.job;
КонецФункции

Функция ПроверитьКлюч() Экспорт
    Ответ = Выполнить("GET", "/api/v1/me");
    Возврат Ответ.Данные;
КонецФункции

Функция ОжидатьЗадание(Знач ИД, Знач Секунд = 60) Экспорт
    Начало = ТекущаяУниверсальнаяДата();
    Пока ТекущаяУниверсальнаяДата() - Начало < Секунд Цикл
        Задание = ПолучитьЗадание(ИД);
        Если Задание.status = "done" Или Задание.status = "error" Тогда
            Возврат Задание;
        КонецЕсли;
        Задержка(2);
    КонецЦикла;
    Возврат ПолучитьЗадание(ИД);
КонецФункции
